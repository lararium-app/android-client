<?xml version="1.0" encoding="utf-8"?>
<!-- Network security configuration for debug builds with user CA override.
     Mirrors the release config: cleartext denied globally; the only cleartext
     exception is the private ranges where a paired hearthd may live. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Paired hearthd endpoints are user-configured and often plain-HTTP on
         the LAN. Net.kt enforces host policy at runtime (including on resolved
         addresses), but the platform HTTP stack applies NSC before app code
         runs. Permit cleartext for private ranges only: RFC1918, Tailscale
         CGNAT, and loopback. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.0.0/8</domain>
        <domain includeSubdomains="true">172.16.0.0/12</domain>
        <domain includeSubdomains="true">192.168.0.0/16</domain>
        <domain includeSubdomains="true">100.64.0.0/10</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>

    <!-- Debug overrides for user-installed CAs during development -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
