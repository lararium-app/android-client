<?xml version="1.0" encoding="utf-8"?>
<!--
    Network security posture (M14):

    The platform stack (HttpURLConnection and friends) never permits
    cleartext except the exact loopback origins below. NSC <domain> entries
    are LITERAL hostname matches — they carry no CIDR semantics, so the
    previously shipped `192.168.0.0/16`-style entries matched nothing and
    enforced nothing while claiming to.

    Cleartext to LAN/tailnet addresses was never NSC's to enforce anyway:
    hearthd traffic rides on app.lararium.hearth.Net, which opens its own
    raw sockets and applies the private-host policy itself (string check
    first, re-check on RESOLVED addresses to defeat DNS rebinding).
    Everything that reaches this config is either loopback or HTTPS: the
    base rule below already covers every SaaS host (openrouter.ai,
    huggingface.co, alphacephei.com, open-meteo.com, github.com — all
    TLS-only), so their old cleartext=false domain blocks granted nothing
    and are gone too.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Literal matches; the paired local llama.cpp / hearthd server. -->
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
